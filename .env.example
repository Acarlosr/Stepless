# ─────────────────────────────────────────────────────────────────────────────
#  Stepless — variáveis de ambiente
#  Copie para .env e preencha. NUNCA faça commit do .env.
# ─────────────────────────────────────────────────────────────────────────────
#
#  ⚠️ MODELO DE CHAVES (mudou na v5, auditoria de mainnet)
#
#  São TRÊS papéis, com TRÊS chaves distintas e independentes. Não derive uma
#  da outra e não reaproveite:
#
#    ADMIN       → multisig (Safe). Configura, pausa, saca. NÃO fica no servidor.
#    RELAYER     → EOA no servidor. Só escreve no Oracle em nome dos usuários.
#    VERIFICADOR → EOA separado. Só aprova/rejeita contribuições.
#
#  Até a v4 as três eram efetivamente a mesma: o relayer era admin, e a chave
#  do verificador era DERIVADA da do relayer por
#  keccak256(RELAYER_PRIVATE_KEY + '-stepless-verifier-v1'). O contrato proíbe
#  auto-verificação justamente para que registrar e aprovar sejam atos de
#  pessoas diferentes — com as duas chaves saindo da mesma semente, quem
#  obtivesse uma tinha as duas e drenava a tesouraria com transações
#  indistinguíveis de uso normal.
#
#  A derivação foi removida. VERIFIER_PRIVATE_KEY agora é obrigatória.
# ─────────────────────────────────────────────────────────────────────────────


# ══ Rede ═════════════════════════════════════════════════════════════════════

# arc-testnet | arc-mainnet
# Todos os valores de rede (chainId, RPC, USDC, Memo, explorer) vêm de
# config/networks.json. Não há endereços chumbados no código.
#
# ⚠️ arc-mainnet ainda tem campos null: em 2026-08-06 a Circle não publicou os
#    endereços de mainnet ("Mainnet addresses are not yet available",
#    docs.arc.io). O backend FALHA AO SUBIR nessa rede de propósito — melhor
#    não subir do que subir com um endereço de USDC chutado, que faria o
#    contrato marcar recompensas como pagas sem mover valor nenhum.
STEPLESS_NETWORK=arc-testnet

# Nó dedicado (Alchemy, QuickNode, Blockdaemon...). Entra no TOPO da lista de
# RPCs; os públicos de config/networks.json ficam como fallback.
# Deixe em branco para usar só os públicos.
ARC_RPC_URL=


# ══ Chaves ═══════════════════════════════════════════════════════════════════

# Relayer — escreve no Oracle em nome dos usuários e paga o gas em USDC.
# NÃO deve ser admin dos contratos: vive aqui, é lida a cada requisição e já
# vazou uma vez no histórico deste repositório. O que ela pode fazer é o teto
# do estrago quando isso se repetir.
RELAYER_PRIVATE_KEY=

# Verificador — assina verifyContribution(). OBRIGATÓRIA e INDEPENDENTE.
# Gere com: cast wallet new
VERIFIER_PRIVATE_KEY=

# Usadas apenas pelos scripts locais (scripts/setup-contracts.mjs,
# scripts/fund-treasury.mjs). NÃO configure na Vercel.
# Em mainnet, prefira não usar: rode o dry-run e assine pelo multisig.
# ADMIN_PRIVATE_KEY=
# FUNDER_PRIVATE_KEY=


# ══ Contratos ════════════════════════════════════════════════════════════════

# Sobrescrevem os endereços de config/networks.json (útil para redeploy
# emergencial sem commit). Vazias = usa o JSON versionado.
ORACLE_ADDRESS=
DISTRIBUTOR_ADDRESS=
X402_ADDRESS=


# ══ Armazenamento de fotos ═══════════════════════════════════════════════════

# JWT do Pinata. A foto é enviada para o IPFS e o dataHash gravado on-chain é o
# keccak256 dos bytes dela.
#
# Sem armazenamento, o hash on-chain não prova nada — não há arquivo contra o
# qual conferi-lo. Era o estado até a v4: o site afirmava "foto com hash
# imutável on-chain" e nenhuma foto era guardada em lugar nenhum.
PINATA_JWT=

# Deixe true em produção: sem armazenamento, /api/upload responde 503 em vez de
# aceitar uma contribuição cuja prova não existe.
REQUIRE_PHOTO_STORAGE=true


# ══ Persistência (Upstash Redis) ═════════════════════════════════════════════

# OBRIGATÓRIO em produção. Sem isso, o fallback em memória perde as pendências
# quando a lambda esfria: a contribuição fica registrada on-chain e o
# verificador não vê mais os metadados para decidir.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ══ Anti-fraude ══════════════════════════════════════════════════════════════

# Governa só os sinais AMBÍGUOS (foto sem GPS, foto antiga). Um GPS que existe e
# aponta para longe do local declarado bloqueia SEMPRE, independente disto.
EXIF_REQUIRED=true

# Contribuições por carteira por dia. O rate limit por IP é anulado trocando de
# rede; como o endereço é onde o USDC cai, é o limite por endereço que importa.
MAX_SUBMISSIONS_PER_DAY=10

# 0 = desligado (o cross-check com o OpenStreetMap roda em paralelo e só informa
# o verificador). Acima de 0, o bloqueio é automático — e a submissão passa a
# esperar a resposta do Overpass, que é lento.
RISK_BLOCK_THRESHOLD=0


# ══ HTTP ═════════════════════════════════════════════════════════════════════

# Origens autorizadas (separadas por vírgula). Vazio = lista padrão do código.
# Era `Access-Control-Allow-Origin: *` em todos os endpoints, o que permitia a
# qualquer site consumir a cota do nó dedicado usando o navegador dos visitantes.
ALLOWED_ORIGINS=https://www.stepless.lat,https://stepless.lat

# Deixe DESLIGADO. Com true, o proxy /api/rpc retransmite transações de
# terceiros por conta da sua cota — e o app não precisa disso (quem escreve
# on-chain é o relayer).
RPC_ALLOW_SEND_RAW_TX=false

# Deixe DESLIGADO em mainnet. Com true, quem tiver ADMIN_API_SECRET aprova
# qualquer contribuição e libera o pagamento, sem registro de QUEM aprovou.
# O caminho normal é o verificador assinar com a própria carteira.
ALLOW_ADMIN_SECRET_VERIFY=false

# Usado apenas por /api/prune-pending. Gere com: openssl rand -hex 32
ADMIN_API_SECRET=
